{
    // F5 : démarre le serveur local, ouvre Edge sur le simulateur, puis y attache le débogueur.
    // On s'attache à un Edge déjà ouvert plutôt que de le faire lancer par VS Code : avec Edge 154, le lancement
    // direct échouait ("Unable to attach to browser" / "Could not find any debuggable target").
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Edge",
            "request": "attach",
            "type": "msedge",
            "port": 9222,
            "urlFilter": "http://localhost:8080/*",
            "timeout": 20000,
            "preLaunchTask": "Edge (débogage)",
            "webRoot": "${workspaceFolder}"
        }
    ]
}
