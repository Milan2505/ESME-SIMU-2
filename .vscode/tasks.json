{
    // Serveur local nécessaire : les modules JS et les fichiers data/asset ne se chargent pas en file://
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Serveur local",
            "type": "shell",
            "command": "python -u -m http.server 8080",
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activesBegin": true,
                    "beginsPattern": "Serving HTTP",
                    "endsPattern": "Serving HTTP"
                }
            }
        }
    ]
}
